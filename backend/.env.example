# backend/.env のテンプレート。コピーして実値を設定する:
#   cp .env.example .env
# springboot3-dotenv が起動時に .env を読み込み、Spring の property source に登録する
# （bootRun でも packaged jar でも有効）。application.yml が ${...} で参照する。
# .env は .gitignore 済み（コミットしない）。

# Firebase Admin SDK のサービスアカウント鍵 JSON への絶対パス
# -> application.yml: firebase.adminsdk.secretkey.path
FIREBASE_ADMINSDK_SECRETKEY_PATH=/path/to/firebase-adminsdk.json

# Firebase Realtime Database の URL
# -> application.yml: firebase.database.url
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

env=local